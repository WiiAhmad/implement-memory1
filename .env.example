# ── Admin Identity ──────────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs allowed to run admin commands
ADMIN_USER_IDS=
# Optional super-admin user ID that can run global-force commands
SUPER_ADMIN_USER_ID=

BOT_TOKEN=123456789:telegram-bot-token
MEMORY_AGENT=data
PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.4-mini
# Chat completion request timeout in milliseconds (30000 = 30 sec)
CHAT_TIMEOUT_MS=12000
# Automatic retries for chat timeout/abort failures (0 disables)
CHAT_TIMEOUT_RETRIES=5
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-openai-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Autonomy Checkpoint & Scheduler ────────────────────────────────────────────
# Scheduler phase: none (off), observer (log only), active (dispatch)
MEMORY_SCHEDULER_PHASE=none
# JSON key name used for autonomy state in the checkpoint file
MEMORY_AUTONOMY_CHECKPOINT_NAMESPACE=memory_autonomy_state
# Enable file-level locking for checkpoint writes (disable for debug only)
MEMORY_AUTONOMY_CHECKPOINT_FILE_LOCK_ENABLED=true

# ── TDAI Memory Feature Gates ──────────────────────────────────────────────────
# Force-after-idle L2 trigger
MEMORY_L2_FORCE_AFTER_IDLE_ENABLED=true
# Startup recovery L2 trigger
MEMORY_L2_STARTUP_RECOVERY_ENABLED=true
# Stale refresh L2 trigger
MEMORY_L2_STALE_REFRESH_ENABLED=true
# Persona stale refresh trigger
MEMORY_PERSONA_STALE_REFRESH_ENABLED=true
# Force persona generation if missing
MEMORY_PERSONA_FORCE_IF_MISSING_ENABLED=true
# Scene archive maintenance
MEMORY_SCENE_ARCHIVE_ENABLED=false
# Scene merge deduplication
MEMORY_SCENE_MERGE_ENABLED=false

# ── Scene Maintenance ──────────────────────────────────────────────────────────
# Days without activity before a scene is marked stale
MEMORY_SCENE_STALE_AFTER_DAYS=14
# Days since stale before a scene is archived
MEMORY_SCENE_ARCHIVE_AFTER_DAYS=21
# Similarity threshold (0.0-1.0) for scene merge detection
MEMORY_SCENE_MERGE_THRESHOLD=0.86

# ── Offload Feature Gates ───────────────────────────────────────────────────────
# Offload data reclamation
OFFLOAD_RECLAIM_ENABLED=true
# Offload L2 wait-entry retry
OFFLOAD_L2_WAIT_RETRY_ENABLED=true

# ── Memory (TDAI) Configuration ──────────────────────────────────────────────
# Storage backend (only sqlite is supported)
MEMORY_STORE_BACKEND=sqlite
# Enable raw conversation capture
MEMORY_CAPTURE_ENABLED=true
# Auto-delete L0/L1 memory data older than N days (0 = disabled, minimum effective: 3)
MEMORY_L0L1_RETENTION_DAYS=0
# Allow retention below 3 days for local memory cleanup
MEMORY_ALLOW_AGGRESSIVE_CLEANUP=false
# Daily memory cleanup time in HH:mm
MEMORY_CLEAN_TIME=03:00
# Enable memory extraction pipeline
MEMORY_EXTRACTION_ENABLED=true
# Deduplicate extracted memories
MEMORY_EXTRACTION_DEDUP=true
# Maximum extracted memories kept per session
MEMORY_MAX_MEMORIES=20

# ── Persona (Scene) Settings ─────────────────────────────────────────────────
# How often (in conversations) to trigger persona/scene extraction
MEMORY_PERSONA_TRIGGER_N=5
# Maximum number of scenes to track
MEMORY_PERSONA_MAX_SCENES=1000
# Number of backup copies to keep
MEMORY_PERSONA_BACKUP_COUNT=3
# Number of scene backup copies to keep
MEMORY_PERSONA_SCENE_BACKUP=10
# Scene extraction LLM timeout in milliseconds (300000 = 5 min)
MEMORY_SCENE_EXTRACTION_TIMEOUT_MS=200000

# ── Pipeline Scheduling ──────────────────────────────────────────────────────
# Run pipeline every N conversation turns
MEMORY_PIPELINE_EVERY_N=10
# Enable pipeline warmup on startup
MEMORY_PIPELINE_WARMUP=true
# L1 idle timeout in seconds (600 = 5 min)
MEMORY_L1_IDLE_TIMEOUT=600
# L2 delay after L1 completes (seconds)
# ⚠ During scheduler migration (Phase 2), set this to 604800 (7 days)
#   to disable the old scheduler's L2 timer. The new scheduler handles L2.
MEMORY_L2_DELAY_AFTER_L1=5
# Minimum interval between L2 runs (seconds)
MEMORY_L2_MIN_INTERVAL=900
# Maximum interval between L2 runs (seconds)
# ⚠ During scheduler migration (Phase 2), set this to 604800 (7 days)
#   to disable the old scheduler's L2 max interval polling.
MEMORY_L2_MAX_INTERVAL=3600
# Session active window (hours) before pipeline deprioritises idle sessions
MEMORY_SESSION_WINDOW_HOURS=24

# ── Memory Recall ────────────────────────────────────────────────────────────
# Enable memory recall when building context
MEMORY_RECALL_ENABLED=true
# Maximum number of recalled memories to inject
MEMORY_RECALL_MAX_RESULTS=5
# Minimum relevance score threshold (0.0–1.0)
MEMORY_RECALL_SCORE_THRESHOLD=0.3
# Retrieval strategy (keyword only in this config)
MEMORY_RECALL_STRATEGY=keyword
# Recall timeout in milliseconds
MEMORY_RECALL_TIMEOUT_MS=5000

# ── Embedding (Disabled by Default) ──────────────────────────────────────────
# Enable embedding-based retrieval (requires provider config below)
MEMORY_EMBEDDING_ENABLED=false
# Embedding provider identifier
MEMORY_EMBEDDING_PROVIDER=none

# ── BM25 Full-Text Search ────────────────────────────────────────────────────
# Enable BM25 keyword-based search
MEMORY_BM25_ENABLED=true
# BM25 language model
MEMORY_BM25_LANGUAGE=en

# ── Offload Module (Context Compression) ──────────────────────────────────────
# Master switch — disable completely when not needed
OFFLOAD_ENABLED=true
# Separate LLM model for offload tasks (L1/L1.5/L2). Falls back to the main MODEL when not set.
OFFLOAD_MODEL=ggpt-5.4-mini
# Offload LLM execution mode: local or backend
OFFLOAD_MODE=backend
# LLM temperature for offload tasks
OFFLOAD_TEMPERATURE=0.2
# Force-trigger L1 summarization when pending tool pairs reaches this count
OFFLOAD_FORCE_TRIGGER_THRESHOLD=4
# Model context window size (tokens)
OFFLOAD_CONTEXT_WINDOW=200000
# Maximum tool pairs per offload batch
OFFLOAD_MAX_PAIRS_PER_BATCH=20
# Enable L1 tool pair summarization (requires OFFLOAD_MODEL)
OFFLOAD_L1_ENABLED=true
# Enable L1.5 task boundary detection
OFFLOAD_L15_ENABLED=true
# Enable L2 Mermaid MMD generation
OFFLOAD_L2_ENABLED=true
# Auto-delete data older than N days (0 = disabled, minimum effective: 3)
OFFLOAD_RETENTION_DAYS=0
# Max total offload debug log size before reclaim truncates logs (MB)
OFFLOAD_LOG_MAX_SIZE_MB=50
# Optional backend offload service settings
OFFLOAD_BACKEND_URL=
OFFLOAD_BACKEND_API_KEY=
OFFLOAD_BACKEND_TIMEOUT_MS=10000
OFFLOAD_USER_ID=

# ── Compression Thresholds ────────────────────────────────────────────────────
# Token utilisation ratio triggering mild compression (0.0–1.0)
OFFLOAD_MILD_RATIO=0.85
# Token utilisation ratio triggering aggressive compression (0.0–1.0)
OFFLOAD_AGGRESSIVE_RATIO=0.85
# Token utilisation ratio triggering emergency compression (0.0–1.0)
OFFLOAD_EMERGENCY_RATIO=0.95
# Target utilisation after emergency compression (0.0–1.0)
OFFLOAD_EMERGENCY_TARGET_RATIO=0.6
# Fraction of oldest messages to delete per aggressive round (0.0–1.0)
OFFLOAD_AGGRESSIVE_DELETE_RATIO=0.4
# Fraction of messages scanned for mild compression candidates (0.0–1.0)
OFFLOAD_MILD_SCAN_RATIO=0.7
# Max fraction of context window for MMD injection (0.0–1.0)
OFFLOAD_MMD_MAX_TOKEN_RATIO=0.2

# ── L2 Scheduling ────────────────────────────────────────────────────────────
# Minimum null-score entries before L2 triggers
OFFLOAD_L2_NULL_THRESHOLD=4
# Seconds since last L2 before a new check runs
OFFLOAD_L2_TIMEOUT_SECONDS=300
