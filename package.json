{
  "name": "agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --outdir dist --target bun --sourcemap --external @node-rs/jieba --external @node-rs/jieba/dict --external @node-rs/jieba-win32-x64-msvc",
    "patch": "bun run scripts/apply-vendor-patch.ts",
    "test": "bun test ./src/**/*.test.ts",
    "test:prod": "bun test ./test/prod/**/*.test.ts",
    "validate:steps": "bun run scripts/validate-step-numbers.ts",
    "postinstall": "bun run patch && bun install --cwd ./TencentDB-Agent-Memory"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/parse-mode": "^2.3.0",
    "@node-rs/jieba": "^2.0.1",
    "@solana/web3.js": "^1.98.4",
    "@tencentdb-agent-memory/tcvdb-text": "^0.1.1",
    "better-sqlite3": "^12.10.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "grammy": "^1.43.0",
    "js-tiktoken": "^1.0.18",
    "json5": "^2.2.3",
    "openai": "^6.39.0",
    "readline-sync": "^1.4.10",
    "sql.js": "^1.14.1",
    "sqlite-vec": "^0.1.9",
    "undici": "^8.1.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  }
}
